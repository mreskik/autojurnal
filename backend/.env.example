APP_PORT=1000
SESSION_TTL_HOURS=168

# URL API yang bisa diakses agent, dipakai di AGENT.md. Kosong = pakai alamat request.
# contoh: https://api.domain.com/api
PUBLIC_API_URL=

# origin frontend yang boleh akses API dari browser (pisah koma). Kosong = http://localhost:5173
CORS_ALLOWED_ORIGINS=

# isi IP Nginx (pisah koma, boleh CIDR) kalau di belakang reverse proxy, contoh: 127.0.0.1
TRUSTED_PROXIES=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_IP_MAX=300
RATE_LIMIT_USER_MAX=120

DB_HOST=localhost
DB_PORT=5432
DB_NAME=autojurnal
DB_USER=postgres
DB_PASS=
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_DEBUG=false

SEED_ADMIN_USERNAME=adminres
SEED_ADMIN_PASSWORD=
